# Spicy Lyrics API — publishable key only (sl_pk_...)
# Get yours at https://spicylyrics.org/developer
VITE_SPICY_LYRICS_KEY=

# Optional: Spotify Canvas via SP_DC cookie (allows standalone canvas fetching without browser extension)
# Extract from browser cookies at open.spotify.com
SP_DC=

# Optional: Custom Spotify Canvas API (e.g. Paxsenix0/Spotify-Canvas-API running locally or on Vercel)
# VITE_SPOTIFY_CANVAS_API=http://localhost:3000
